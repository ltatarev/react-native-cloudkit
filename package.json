{
  "name": "@ltatarev/react-native-cloudkit",
  "version": "0.0.0",
  "description": "CloudKit sync and zone-wide sharing for bare React Native apps, on CKSyncEngine",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "ltatarev-react-native-cloudkit-source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json",
    "./react": {
      "ltatarev-react-native-cloudkit-source": "./src/react/index.ts",
      "types": "./lib/typescript/src/react/index.d.ts",
      "default": "./lib/module/react/index.js"
    }
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "nitrogen",
    "nitro.json",
    "*.podspec",
    "CHANGELOG.md",
    "!ios/build",
    "!ios/Tests",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace @ltatarev/react-native-cloudkit-example",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "prepare": "bob build",
    "nitrogen": "nitrogen",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "test": "jest",
    "test:swift": "./scripts/test-swift.sh",
    "release": "release-it",
    "release:alpha": "release-it --preRelease=alpha"
  },
  "keywords": [
    "react-native",
    "ios",
    "cloudkit",
    "icloud",
    "sync",
    "offline-first",
    "sharing",
    "ckshare",
    "cksyncengine",
    "nitro-modules"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ltatarev/react-native-cloudkit.git"
  },
  "author": "Lucija Tatarević <lucija.tatarevic@gmail.com> (https://github.com/ltatarev)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ltatarev/react-native-cloudkit/issues"
  },
  "homepage": "https://github.com/ltatarev/react-native-cloudkit#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@react-native/babel-preset": "0.86.0",
    "@react-native/eslint-config": "0.86.2",
    "@release-it/conventional-changelog": "^12.0.2",
    "@types/jest": "^29",
    "@types/react": "^19.2.0",
    "babel-jest": "^29",
    "del-cli": "^7.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^29",
    "nitrogen": "0.35.9",
    "prettier": "^3.9.6",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-builder-bob": "^0.43.1",
    "react-native-nitro-modules": "0.35.9",
    "release-it": "^21.1.0",
    "turbo": "^2.10.8",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": ">=0.35.9"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@4.11.0",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "custom",
        {
          "script": "nitrogen",
          "clean": "nitrogen/"
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "create-react-native-library": {
    "type": "nitro-module",
    "languages": "kotlin-swift",
    "tools": [
      "eslint"
    ],
    "version": "0.63.1"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "${version}",
      "requireBranch": "main"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true,
      "releaseName": "${version}"
    },
    "hooks": {
      "before:init": "yarn typecheck && yarn lint && yarn test && yarn test:swift"
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "conventionalcommits"
        },
        "infile": "CHANGELOG.md",
        "header": "# Changelog"
      }
    }
  }
}
